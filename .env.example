# Agent Control Center 的全部環境變數（以 apps/server 與 packages/adapters 實際讀取的為準）。都是可選的，留空即用預設值。
# 注意：目前不會自動讀取 .env 檔案（路線圖 P1-16）。請在啟動前、在同一個終端裡設定，例如：
#   PowerShell：$env:ACC_NO_OPEN = "1"; npm start
#   bash：ACC_NO_OPEN=1 npm start
# 不要把真實的令牌、金鑰寫進這個檔案或提交到倉庫。
ACC_PORT=8788
# 只監聽本機（預設）。改成區域網地址或 0.0.0.0 時必須同時設定 ACC_TOKEN_FILE，否則拒絕啟動
ACC_HOST=127.0.0.1
# ---- 訪問控制（本機其他網頁 / 程式不能冒充你操作控制台）----
# 啟動時會列印帶令牌的“訪問連結”；npm start / start:real 會自動用預設瀏覽器開啟它，進入一次後瀏覽器會記住登入（30 天）。
# 令牌預設儲存在資料目錄下的 access-token（只有當前使用者能讀取，每次啟動自檢，重啟後不變）。
# 設為 1 則啟動時不自動開啟瀏覽器（開發模式 npm run dev 本來就不開啟）
ACC_NO_OPEN=
# 自己指定令牌檔案（至少 32 個字元；不存在時自動生成）。監聽非本機地址時必填。不要把令牌本身寫進環境變數
ACC_TOKEN_FILE=
# 監聽非本機地址時，允許的訪問主機名（逗號分隔，例如 192.168.1.20,my-pc.local）
ACC_ALLOWED_HOSTS=
# 前端開發伺服器埠（npm run dev；服務端在開發模式下只放行這個埠的頁面）
ACC_WEB_PORT=5174
# 只允許在這些目錄（按系統路徑分隔符分隔：Windows 用 ; 其他系統用 :）下建立任務；預設不限制
ACC_ALLOWED_ROOTS=
# 即時推送（WebSocket）的同時連線數上限與單條訊息大小上限（位元組）
ACC_WS_MAX_CONNECTIONS=32
ACC_WS_MAX_PAYLOAD=65536
# 資料目錄（資料庫 + 單實例鎖 + 日誌 + 訪問令牌）。預設是當前使用者的資料目錄，不在 agent 的工作區裡：
#   Windows：%LOCALAPPDATA%\agent-control-center
#   macOS：~/Library/Application Support/agent-control-center
#   其他：$XDG_DATA_HOME/agent-control-center（未設定時 ~/.local/share/agent-control-center）
# 同一個資料目錄同一時間只能有一個服務在用：重複啟動時第二個以 ACC_ALREADY_RUNNING 退出，並提示已在執行的程序號和地址。
# 舊版本放在啟動目錄下的 agent-control.db 會在第一次啟動時自動遷移過來（舊檔案作為 agent-control.db.bak-時間戳
# 備份到資料目錄的 legacy-backups 裡；舊的 logs/events.log 和之前遷移留下的 .bak-* 也會一併移過去，不留在工作區）。
ACC_DATA_DIR=
# 單獨指定資料庫檔案 / 日誌目錄（優先於 ACC_DATA_DIR；顯式指定資料庫時不做自動遷移）
ACC_DB_PATH=
ACC_LOG_DIR=
# 資料庫或日誌落在預設工作區內時預設拒絕啟動（agent 能改到它們）；設為 1 只告警、不攔截。
# 這個開關只容忍“資料在預設工作區裡”：任務目錄落在資料目錄之內、或包含工作區以外的控制面資料時仍然拒絕
ACC_ALLOW_DATA_IN_WORKSPACE=
# sqlite (default) | memory
ACC_STORE=sqlite
# 預算檢查與步驟看門狗的檢查間隔（毫秒）
ACC_BUDGET_CHECK_MS=5000
# 步驟不活動看門狗（毫秒）：自動流程裡正在工作的 AI 超過這麼久沒有任何動靜（包括逐字輸出），
# 就先重新接上它的對話再試一次，仍然沒有動靜就請另一個 AI 唯讀診斷，最後才停下來等你處理。
# 預設 900000（15 分鐘，比單個長命令或測試的 10 分鐘上限更長）；等你審批 / 確認的時間不算。0 表示關閉。
# 新建任務時寫進任務設定；建立任務的 API 也可以用 inactivityTimeoutMs 單獨指定。非法值（負數、非整數）會拒絕啟動。
ACC_STEP_INACTIVITY_MS=900000
# 空閒會話回收（P1-5）：AI 答完話後閒置超過這麼久（毫秒），就關掉它背後的 Claude CLI 程序釋放記憶體（每個幾百 MB）；
# 下次再發訊息會自動接回原來的對話，上下文不丟。預設 600000（10 分鐘），0 表示關閉。
ACC_IDLE_SESSION_MS=600000
# 每個新任務的估算花費上限（美元，P1-7）：只有 Claude 上報美元，按官方價格估算（訂閱登入時不是實際帳單）。
# 超過就先停下等你決定（可以一鍵「放寬預算並繼續」）。留空表示不限。
ACC_MAX_COST_USD=
# 全域性每日估算花費上限（美元，P1-7）：今天所有任務加起來達到後，不再開始新的 AI 呼叫，明天自動恢復。留空表示不限。
ACC_DAILY_MAX_COST_USD=
# 自動清理（P1-12）：已經結束超過這麼多天的任務會被刪除（連同對話和用量記錄）。0 表示永久保留（預設）。
ACC_RETENTION_DAYS=0
# 工作區檢查點（P2-3）：每一輪 AI 做完後給 git 工作區拍快照，可以在「改動」頁簽檢視並撤銷最後一輪。0 表示關閉。
ACC_CHECKPOINTS=1
# 脫敏（P2-9）：AI 輸出與工具輸出裡的金鑰（金鑰類環境變數的值、常見金鑰格式）在記錄和顯示前遮掉。0 表示關閉。
ACC_REDACT=1
# 交接白名單（P2-5）：只允許這些方向的 AI 之間交接／諮詢，例如 claude>codex,codex>claude；留空表示不限。
ACC_HANDOFF_EDGES=
# 自動放行（P2-7）：沒有 policy.json 時的預設自主度 ask / rules / unattended；之後在介面「自動放行」頁切換。
ACC_AUTONOMY=rules
# 連續自動放行幾次之後要你確認一次（你處理一次就重新計數）。
ACC_MAX_AUTO_APPROVALS=25
# AI 提的問題幾分鐘沒人回答就跳過、讓 AI 自己判斷（P2-6）；0 表示一直等。
ACC_QUESTION_TIMEOUT_MIN=0
# 追蹤（P2-2）：任務結束後把 OpenTelemetry 追蹤發到這個位址（例如本機 Phoenix：http://localhost:6006）；留空不發。
ACC_OTLP_ENDPOINT=
# 追蹤要帶的標頭（k=v,k2=v2）；ACC_OTLP_CONTENT=1 才附帶命令與工具輸入摘要（預設只有中繼資料）。
ACC_OTLP_HEADERS=
ACC_OTLP_CONTENT=0
# 執行隔離（P2-8）：測試在沙箱裡執行（需要 @anthropic-ai/sandbox-runtime；Windows 另需以系統管理員執行一次 windows-install）。0 表示關閉。
ACC_TEST_SANDBOX=1
# 沙箱裡的測試允許連的網域（逗號分隔）；留空用預設（npm、PyPI、crates、Go、GitHub）。
ACC_TEST_ALLOWED_DOMAINS=
# 其他 AI（P2-1，透過 ACP 協議接入）：內建 gemini、opencode，逗號分隔；需要先安裝對應的命令列工具。
ACC_ACP_AGENTS=
# 自訂 ACP agent（JSON 陣列）：[{"id":"x","name":"X","command":"npx","args":["-y","套件@1.2.3"],"env":{"secrets":["X_API_KEY"]}}]；npx 必須固定版本號。
ACC_ACP_AGENTS_JSON=
# Claude Code 執行檔的位置；一般不用設定（SDK 會自己找，桌面版會自動填入）。
ACC_CLAUDE_EXECUTABLE=
# 桌面版自動更新（從 GitHub Releases 檢查新版本）；0 表示關閉。
ACC_AUTO_UPDATE=1
# mock | real（real：claude 走 Claude Agent SDK，codex 走 Codex App Server）；npm run start:real 會自動設為 real
ACC_RUNTIME_MODE=mock
# agent 的預設工作目錄（預設為啟動命令所在目錄）與 real 模式下的可選模型
ACC_WORKSPACE=
ACC_CLAUDE_MODEL=
ACC_CODEX_MODEL=
# codex 可執行檔案（預設 PATH 中的 codex）。建議用不含空格的路徑（含空格的路徑目前可能啟動失敗，見路線圖 P1-5）
ACC_CODEX_BIN=
# 服務端日誌級別（預設 warn；info 會列印每個請求，請求 URL 裡的訪問令牌會被隱去）。ACC_LOG_REQUESTS=1 等同於 info
ACC_LOG_LEVEL=
ACC_LOG_REQUESTS=
# ---- 子程序的環境變數（P0-8，不需要配置）----
# Claude、Codex 和測試命令不再繼承這裡的全部環境變數，只拿到白名單裡的變數：
#   測試命令：系統路徑、臨時目錄、使用者目錄、語言編碼、代理、Node / 常見工具鏈的位置；任何 *_API_KEY / *_TOKEN / *_SECRET 都不給；
#   Claude：再加 ANTHROPIC_* / CLAUDE_*（用 Bedrock / Vertex 時再加對應雲的憑據）；
#   Codex：再加 OPENAI_* / CODEX_*，以及 ~/.codex/config.toml 裡 env_key / env_vars / bearer_token_env_var / env_http_headers
#   點名的變數；Codex 執行的命令只繼承核心變數。
#   Claude 用 ~/.claude/settings.json 的 env（閘道器 / 中轉、Bedrock）、apiKeyHelper 認證時不需要改任何配置：ACC 會唯讀轉交這些設定。
# ACC_* 開頭的變數（包括 ACC_TOKEN_FILE）一律不傳給任何子程序。
# 測試命令還需要別的變數時（例如整合測試的 DATABASE_URL、Playwright 的 PLAYWRIGHT_BROWSERS_PATH），在這裡列出名字（逗號分隔）；
# 名字像憑據的（*_API_KEY、*_TOKEN、*_PASSWORD……）即使列出來也不會傳。測試失敗時結果裡會列出沒有傳入的變數名。
ACC_TEST_ENV_ALLOW=
# Real runtime adapters will use the user's existing Claude Code / Codex authentication.
